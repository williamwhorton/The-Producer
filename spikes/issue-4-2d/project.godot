; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot 4 2D Isometric Prototype"
config/description="Isometric dollhouse comparison prototype for Issue #13. Demonstrates two-level house rendering with room geometry, floor visibility, markers and camera controls using Godot 4 primitives only."
config/features=PackedStringArray("4.7")

[rendering]

graphics/antialiasing/gi_enabled=false
graphics/antialiasing/denoiser/shader_quality=0
graphics/antialiasing/upscale_filter/sprite_texture/default/mipmaps_clamped=true
